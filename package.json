{
  "name": "almostyellow",
  "private": true,
  "scripts": {
    "dev": "pnpm open-browser && next dev --turbopack",
    "open-browser": "start http://localhost:3000",
    "build": "pnpm run lint && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "prettier . --write && pnpm run lint && vitest run && pnpm test:ci && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/e2e.mts",
    "emulators": "firebase emulators:start --project demo-almostyellow --only auth,firestore",
    "test:firebase": "vitest run -c vitest.firebase.config.mts",
    "test:rules": "firebase emulators:exec --project demo-almostyellow --only auth,firestore \"vitest run -c vitest.firebase.config.mts tests/firebase/rules.test.ts\"",
    "test:ci": "firebase emulators:exec --project demo-almostyellow-ci --only auth,firestore \"pnpm test:firebase\"",
    "test-only": "pnpm run lint && vitest run && pnpm test:ci && node scripts/e2e.mts --no-build",
    "pretty": "prettier . --write",
    "pretty-check": "prettier . --check",
    "pretty-lint": "prettier . --write && pnpm run lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/form": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@tabler/icons-react": "^3.49.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.4",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "^15.34.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
