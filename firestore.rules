rules_version = '2';

// Everything is denied unless a rule below allows it. Writes must match the
// record's shape exactly: no missing or extra fields, and the right types.
// The Admin SDK used by the server and the seeding code bypasses these rules,
// so server actions check the caller themselves, see requireAuth in src/auth.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    // Only people listed in authorizedUsers count as signed in. A Firebase
    // account that is not listed gets no more access than an anonymous visitor.
    function isAuthorized() {
      return request.auth != null
        && exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid));
    }

    function incoming() {
      return request.resource.data;
    }

    function hasExactly(fields) {
      return incoming().keys().hasAll(fields)
        && incoming().keys().hasOnly(fields);
    }

    function isText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isWholeNumberBetween(value, low, high) {
      return value is int && value >= low && value <= high;
    }

    // Timestamps must come from the server (serverTimestamp() in the client),
    // and createdAt can never change once set
    function hasNewTimestamps() {
      return incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
    }

    function hasUpdatedTimestamps() {
      return incoming().createdAt == resource.data.createdAt
        && incoming().updatedAt == request.time;
    }

    function isWhisky() {
      return hasExactly(["name", "distillery", "countryRegion", "age", "grain",
          "abv", "rating", "price", "notes", "createdAt", "updatedAt"])
        && isText(incoming().name, 255)
        && isText(incoming().distillery, 255)
        && isText(incoming().countryRegion, 255)
        && isWholeNumberBetween(incoming().age, 0, 100)
        && isText(incoming().grain, 255)
        && incoming().abv is number
        && incoming().abv > 0 && incoming().abv <= 100
        && isWholeNumberBetween(incoming().rating, 1, 5)
        && isWholeNumberBetween(incoming().price, 1, 3)
        && incoming().notes is string && incoming().notes.size() <= 5000;
    }

    function isFilm() {
      return hasExactly(["name", "releaseYear", "top30", "watched", "notInJar"])
        && isText(incoming().name, 255)
        // Postgres kept years as text; Firestore keeps them as numbers
        && isWholeNumberBetween(incoming().releaseYear, 1800, 2100)
        && incoming().top30 is bool
        && incoming().watched is bool
        && incoming().notInJar is bool;
    }

    function isCocktail() {
      return hasExactly(["name", "ingredients", "method", "rating"])
        && isText(incoming().name, 255)
        // Rules cannot loop over a list, so the ingredients themselves are
        // only checked by the app
        && incoming().ingredients is list
        && incoming().ingredients.size() > 0
        && incoming().ingredients.size() <= 50
        && isText(incoming().method, 5000)
        && isWholeNumberBetween(incoming().rating, 1, 5);
    }

    // updatedBy must be whoever makes the change, so nobody can make one in
    // someone else's name
    function isShoppingItem() {
      return hasExactly(["text", "checked", "order", "createdAt", "updatedAt",
          "updatedBy"])
        && isText(incoming().text, 255)
        && incoming().checked is bool
        && incoming().order is number
        && incoming().updatedBy == request.auth.uid;
    }

    // Public to read, authorised users to change
    match /whiskies/{id} {
      allow read: if true;
      allow create: if isAuthorized() && isWhisky() && hasNewTimestamps();
      allow update: if isAuthorized() && isWhisky() && hasUpdatedTimestamps();
      allow delete: if isAuthorized();
    }
    match /films/{id} {
      allow read: if true;
      allow create, update: if isAuthorized() && isFilm();
      allow delete: if isAuthorized();
    }
    match /cocktails/{id} {
      allow read: if true;
      allow create, update: if isAuthorized() && isCocktail();
      allow delete: if isAuthorized();
    }

    // Private to authorised users
    match /shoppingItems/{id} {
      allow read: if isAuthorized();
      allow create: if isAuthorized() && isShoppingItem() && hasNewTimestamps();
      allow update: if isAuthorized() && isShoppingItem()
        && hasUpdatedTimestamps();
      allow delete: if isAuthorized();
    }

    // The allowlist is managed with the Admin SDK only, which bypasses rules
    match /authorizedUsers/{uid} {
      allow read, write: if false;
    }
  }
}
