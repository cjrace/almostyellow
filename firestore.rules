rules_version = '2';

// Baseline rules for the emulator tests. Everything is denied unless a rule
// below allows it. Field validation and the final permission model arrive with
// Firebase Authentication, see the migration plan.
service cloud.firestore {
  match /databases/{database}/documents {

    // Only people listed in authorizedUsers count as signed in. A Firebase
    // account that is not listed gets no more access than an anonymous visitor.
    function isAuthorized() {
      return request.auth != null
        && exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid));
    }

    // Public to read, authorised users to change
    match /whiskies/{id} {
      allow read: if true;
      allow write: if isAuthorized();
    }
    match /films/{id} {
      allow read: if true;
      allow write: if isAuthorized();
    }
    match /cocktails/{id} {
      allow read: if true;
      allow write: if isAuthorized();
    }

    // Private to authorised users
    match /shoppingItems/{id} {
      allow read, write: if isAuthorized();
    }

    // The allowlist is managed with the Admin SDK only, which bypasses rules
    match /authorizedUsers/{uid} {
      allow read, write: if false;
    }
  }
}
